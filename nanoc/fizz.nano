// FizzBuzz do 15
let i = 0;
while (i < 15) {
    i = i + 1;
    if (i % 15 == 0) {
        println "FizzBuzz";
    } else {
        if (i % 3 == 0) {
            println "Fizz";
        } else {
            if (i % 5 == 0) {
                println "Buzz";
            } else {
                print i;
                println "";
            }
        }
    }
}
println "=== done ===";
